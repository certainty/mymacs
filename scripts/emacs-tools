#!/usr/bin/env bash

set -euo pipefail

ROOT="${EMACS_CONFIG_ROOT:-$(pwd)}"
EMACS_BIN="${EMACS:-emacs}"
INIT_DIR="${EMACS_CONFIG_ROOT:-}"

usage() {
  cat <<EOF
Usage:
  emacs-tools <subcommand> [args...]

Environment:
  EMACS
      Emacs binary to execute. Defaults to "emacs".

Subcommands:
  vanilla
      Start Emacs with -Q

  debug
      Start Emacs with --debug-init

  batch-load <file>
      Load a file in batch mode

  eval <elisp>
      Evaluate arbitrary elisp in batch mode

  check-parens <file>
      Check parentheses balance in an elisp file

  byte-compile <file...>
      Byte compile one or more files

  native-compile <file...>
      Native compile one or more files

  batch-check
      Load init.el in batch mode

  doctor
      Run basic config diagnostics:
        - load init.el
        - byte compile all .el files
        - check parens for all .el files

  startup-log [logfile]
      Run startup with --debug-init and capture logs

  describe-function <symbol>
      Print function documentation.
      Uses --init-directory when EMACS_CONFIG_ROOT is set so
      third-party packages from that config root are available for inspection.

  describe-variable <symbol>
      Print variable documentation.
      Uses --init-directory when EMACS_CONFIG_ROOT is set so
      third-party packages from that config root are available for inspection.

  find-library <library>
      Locate an Emacs library.
      Uses --init-directory when EMACS_CONFIG_ROOT is set so
      third-party packages from that config root are available for lookup.

  manual [topic]
      Open an Info manual
      Examples:
        emacs-tools manual emacs
        emacs-tools manual elisp
        emacs-tools manual org

  ert <test-file>
      Run ERT tests in batch mode

Examples:
  emacs-tools check-parens init.el
  emacs-tools byte-compile lisp/foo.el
  emacs-tools eval "(message \"hello\")"
  emacs-tools doctor
  emacs-tools manual elisp

  In this repo, use EMACS_CONFIG_ROOT=emacs.d for live config.
  EMACS_CONFIG_ROOT can also target another config root when needed:
    EMACS_CONFIG_ROOT=emacs.d emacs-tools describe-variable corfu-auto
EOF
}

require_arg() {
  if [[ $# -lt 1 ]]; then
    echo "missing argument" >&2
    exit 1
  fi
}

find_elisp_files() {
  find "${ROOT}" \
    -path "${ROOT}/straight" -prune -o \
    -path "${ROOT}/elpa" -prune -o \
    -type f -name "*.el" -print
}

prune_local_elc_files() {
  find "${ROOT}" -maxdepth 1 -type f -name "*.elc" -delete
  if [[ -d "${ROOT}/modules" ]]; then
    find "${ROOT}/modules" -maxdepth 1 -type f -name "*.elc" -delete
  fi
}

interactive_profile_args=()
batch_profile_args=()

build_interactive_profile_args() {
  interactive_profile_args=()
  if [[ -n "${INIT_DIR}" ]]; then
    interactive_profile_args+=("--init-directory=${INIT_DIR}")
    if [[ -d "${INIT_DIR}/modules" ]]; then
      interactive_profile_args+=("-L" "${INIT_DIR}/modules")
    fi
  else
    interactive_profile_args+=("-Q")
  fi
}

build_batch_profile_args() {
  batch_profile_args=("-Q" "--batch")

  if [[ -n "${INIT_DIR}" ]]; then
    batch_profile_args+=(
      "--eval" "(setq user-emacs-directory (file-name-as-directory (expand-file-name \"${ROOT}\")))"
      "--eval" "(setq early-init-file (expand-file-name \"early-init.el\" user-emacs-directory))"
      "--eval" "(setq user-init-file (expand-file-name \"init.el\" user-emacs-directory))"
    )

    if [[ -f "${ROOT}/early-init.el" ]]; then
      batch_profile_args+=("-l" "${ROOT}/early-init.el")
    fi

    batch_profile_args+=(
      "--eval" "(require 'package)"
      "--eval" "(when package-enable-at-startup (package-activate-all))"
    )

    if [[ -f "${ROOT}/init.el" ]]; then
      batch_profile_args+=("-l" "${ROOT}/init.el")
    fi
  fi
}

cmd="${1:-}"
shift || true

case "${cmd}" in
  vanilla)
    exec "${EMACS_BIN}" -Q
    ;;

  debug)
    build_interactive_profile_args
    exec "${EMACS_BIN}" "${interactive_profile_args[@]}" --debug-init "$@"
    ;;

  batch-load)
    require_arg "$@"
    build_batch_profile_args
    exec "${EMACS_BIN}" "${batch_profile_args[@]}" -l "$1"
    ;;

  eval)
    require_arg "$@"
    build_batch_profile_args
    exec "${EMACS_BIN}" "${batch_profile_args[@]}" \
      --eval "$1"
    ;;

  check-parens)
    require_arg "$@"
    file="$1"
    exec "${EMACS_BIN}" -Q --batch \
      --eval "
      (condition-case err
          (progn
            (find-file \"${file}\")
            (check-parens)
            (message \"OK: parentheses balanced\"))
        (error
          (message \"%s\" err)
          (kill-emacs 1)))
      "
    ;;

  byte-compile)
    require_arg "$@"
    prune_local_elc_files
    build_batch_profile_args
    exec "${EMACS_BIN}" "${batch_profile_args[@]}" \
      -f batch-byte-compile \
      "$@"
    ;;

  native-compile)
    require_arg "$@"
    prune_local_elc_files
    build_batch_profile_args
    exec "${EMACS_BIN}" "${batch_profile_args[@]}" \
      -f batch-native-compile \
      "$@"
    ;;

  batch-check)
    prune_local_elc_files
    build_batch_profile_args
    exec "${EMACS_BIN}" "${batch_profile_args[@]}"
    ;;

  doctor)
    prune_local_elc_files
    build_batch_profile_args
    echo "==> loading init.el"
    "${EMACS_BIN}" "${batch_profile_args[@]}"

    echo
    echo "==> checking parens"

    while IFS= read -r file; do
      echo "checking ${file}"

      "${EMACS_BIN}" -Q --batch \
        --eval "
        (condition-case err
            (progn
              (find-file \"${file}\")
              (check-parens))
          (error
            (message \"%s\" err)
            (kill-emacs 1)))
        "
    done < <(find_elisp_files)

    echo
    echo "==> byte compiling"

    mapfile -t files < <(find_elisp_files)

    "${EMACS_BIN}" "${batch_profile_args[@]}" \
      -f batch-byte-compile \
      "${files[@]}"

    echo
    echo "doctor completed successfully"
    ;;

  startup-log)
    logfile="${1:-startup.log}"
    build_interactive_profile_args

    {
      "${EMACS_BIN}" "${interactive_profile_args[@]}" --debug-init --batch \
        --eval '(message "startup complete")'
    } >"${logfile}" 2>&1
    ;;

  describe-function)
    require_arg "$@"
    symbol="$1"
    build_batch_profile_args
    exec "${EMACS_BIN}" "${batch_profile_args[@]}" \
      --eval "
      (princ
        (documentation
          (quote ${symbol})))
      "
    ;;

  describe-variable)
    require_arg "$@"
    symbol="$1"
    build_batch_profile_args
    exec "${EMACS_BIN}" "${batch_profile_args[@]}" \
      --eval "
      (princ
        (documentation-property
          (quote ${symbol})
          'variable-documentation))
      "
    ;;

  find-library)
    require_arg "$@"
    build_batch_profile_args
    exec "${EMACS_BIN}" "${batch_profile_args[@]}" \
      --eval "
      (princ
        (locate-library \"$1\"))
      "
    ;;

  manual)
    topic="${1:-emacs}"

    exec "${EMACS_BIN}" -Q \
      --eval "(info \"${topic}\")"
    ;;

  ert)
    require_arg "$@"
    test_file="$1"

    exec "${EMACS_BIN}" -Q --batch \
      -l "${test_file}" \
      -f ert-run-tests-batch-and-exit
    ;;

  ""|-h|--help|help)
    usage
    ;;

  *)
    echo "unknown subcommand: ${cmd}" >&2
    usage
    exit 1
    ;;
esac

;;; taskwarrior-test.el --- Tests for Taskwarrior integration -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'package)
(package-initialize)
(add-to-list 'load-path
             (expand-file-name "../user-lisp/taskwarrior"
                               (file-name-directory (or load-file-name
                                                        buffer-file-name))))
(require 'taskwarrior-core)
(require 'taskwarrior)

(ert-deftest taskwarrior-parse-arguments-preserves-quoted-values ()
  (should (equal (taskwarrior-parse-arguments
                  "A task project:work 'due:next monday'")
                 '("A" "task" "project:work" "due:next monday"))))

(ert-deftest taskwarrior-tasks-decodes-json-export ()
  (let (received)
    (cl-letf (((symbol-function 'taskwarrior-run)
               (lambda (&rest arguments)
                 (setq received arguments)
                 "[{\"uuid\":\"abc\",\"description\":\"Test\"}]")))
      (let ((tasks (taskwarrior-tasks "ready" '("project:work"))))
        (should (equal received '("project:work" "export" "ready")))
        (should (equal (gethash "uuid" (car tasks)) "abc"))))))

(ert-deftest taskwarrior-run-on-uses-uuids-and-disables-cli-confirmation ()
  (let (received)
    (cl-letf (((symbol-function 'taskwarrior-run)
               (lambda (&rest arguments)
                 (setq received arguments)
                 "ok")))
      (should (equal (taskwarrior-run-on '("one" "two") "modify" "+next")
                     "ok"))
      (should (equal received
                     '("rc.confirmation=no" "one" "two" "modify" "+next"))))))

(ert-deftest taskwarrior-report-mode-is-read-only-and-has-report-controls ()
  (with-temp-buffer
    (taskwarrior-report-mode)
    (should (eq (lookup-key taskwarrior-report-mode-map (kbd "g"))
                #'taskwarrior-report-refresh))
    (should (eq (lookup-key taskwarrior-report-mode-map (kbd "r"))
                #'taskwarrior-list-select-report))
    (should-not (eq (lookup-key taskwarrior-report-mode-map (kbd "d"))
                    #'taskwarrior-list-done))))

(ert-deftest taskwarrior-list-mode-provides-list-controls ()
  (with-temp-buffer
    (taskwarrior-list-mode)
    (dolist (binding '(("m" . taskwarrior-list-toggle-mark)
                       ("M" . taskwarrior-list-modify)
                       ("A" . taskwarrior-list-annotate)
                       ("n" . taskwarrior-list-toggle-next)
                       ("d" . taskwarrior-list-done)
                       ("x" . taskwarrior-list-delete)
                       ("b" . taskwarrior-list-start)
                       ("B" . taskwarrior-list-stop)
                       ("D" . taskwarrior-list-dates-menu)
                       ("i" . taskwarrior-list-information)
                       ("." . taskwarrior-list-schedule-today)
                       (">" . taskwarrior-list-schedule-tomorrow)
                       ("c" . taskwarrior-list-select-context)
                       ("s" . tabulated-list-sort)
                       ("!" . taskwarrior-list-run-command)
                       ("U" . taskwarrior-list-undo)))
      (should (eq (lookup-key taskwarrior-list-mode-map (kbd (car binding)))
                  (cdr binding))))))

(ert-deftest taskwarrior-list-modifications-skip-confirmation ()
  (let (received)
    (cl-letf (((symbol-function 'taskwarrior-list--selected-uuids)
               (lambda () '("abc")))
              ((symbol-function 'yes-or-no-p)
               (lambda (&rest _) (ert-fail "Unexpected confirmation")))
              ((symbol-function 'taskwarrior-run-on)
               (lambda (&rest arguments)
                 (setq received arguments)
                 "Modified"))
              ((symbol-function 'taskwarrior-list--message-output) #'ignore)
              ((symbol-function 'taskwarrior-list-refresh) #'ignore))
      (taskwarrior-list-modify "project:work")
      (should (equal received '(("abc") "modify" "project:work")))
      (setq received nil)
      (taskwarrior-list-set-date "due" "tomorrow")
      (should (equal received '(("abc") "modify" "due:tomorrow")))
      (taskwarrior-list-start)
      (should (equal received '(("abc") "start")))
      (taskwarrior-list-stop)
      (should (equal received '(("abc") "stop")))
      (taskwarrior-list-done)
      (should (equal received '(("abc") "done"))))))

(ert-deftest taskwarrior-list-popup-action-is-deterministic ()
  (let ((action (taskwarrior-list--popup-action)))
    (should (equal (alist-get 'window-height action)
                   taskwarrior-list-popup-height))
    (should (equal (alist-get 'window-parameters action)
                   '((no-other-window . t)
                     (no-delete-other-windows . t))))))

(ert-deftest taskwarrior-list-updates-visible-information-on-navigation ()
  (let (updated)
    (cl-letf (((symbol-function 'get-buffer-window)
               (lambda (&rest _) 'information-window))
              ((symbol-function 'get-text-property)
               (lambda (&rest _) "next-uuid"))
              ((symbol-function 'taskwarrior-list--display-information)
               (lambda (uuid &optional _source-window)
                 (setq updated uuid))))
      (setq taskwarrior-list--information-uuid "old-uuid")
      (taskwarrior-list--update-information)
      (should (equal updated "next-uuid"))
      (should (equal taskwarrior-list--information-uuid "next-uuid")))))

(ert-deftest taskwarrior-list-closes-information-with-report ()
  (let (closed)
    (cl-letf (((symbol-function 'get-buffer-window)
               (lambda (&rest _) 'information-window))
              ((symbol-function 'quit-window)
               (lambda (&rest arguments) (setq closed arguments))))
      (taskwarrior-list--close-information-window)
      (should (equal closed '(nil information-window))))))

(ert-deftest taskwarrior-list-popup-regexp-matches-taskwarrior-buffers ()
  (should (string-match-p taskwarrior-list--display-regexp "*Taskwarrior*"))
  (should (string-match-p taskwarrior-list--display-regexp
                          "*Taskwarrior Report*"))
  (should (string-match-p taskwarrior-list--display-regexp
                          "*Taskwarrior Task*")))

(ert-deftest taskwarrior-list-display-rule-precedes-catch-all ()
  (let ((display-buffer-alist '((".*" display-buffer-same-window))))
    (taskwarrior-list--install-display-rule)
    (should (equal (caar display-buffer-alist)
                   taskwarrior-list--display-regexp))))

(ert-deftest taskwarrior-list-report-capabilities-default-unknown-to-read-only ()
  (should (taskwarrior-list--task-report-p "ready"))
  (should-not (taskwarrior-list--task-report-p "summary"))
  (should-not (taskwarrior-list--task-report-p "my-custom-report")))

(ert-deftest taskwarrior-list-calendar-date-converts-to-iso ()
  (should (equal (taskwarrior-list--calendar-date-string '(3 7 2027))
                 "2027-03-07")))

(ert-deftest taskwarrior-list-date-shortcuts-use-taskwarrior-date-expressions ()
  (let (received)
    (cl-letf (((symbol-function 'taskwarrior-list--set-date)
               (lambda (field date) (setq received (list field date)))))
      (taskwarrior-list-schedule-today)
      (should (equal received '("scheduled" "today")))
      (taskwarrior-list-schedule-eom)
      (should (equal received '("scheduled" "eom")))
      (taskwarrior-list-deadline-tomorrow)
      (should (equal received '("due" "tomorrow")))
      (taskwarrior-list-schedule-clear)
      (should (equal received '("scheduled" ""))))))

(ert-deftest taskwarrior-list-toggle-next-uses-selected-task-state ()
  (let ((taskwarrior-list--tasks-by-uuid (make-hash-table :test 'equal))
        received)
    (puthash "abc" (let ((task (make-hash-table :test 'equal)))
                     (puthash "tags" '("next") task)
                     task)
             taskwarrior-list--tasks-by-uuid)
    (cl-letf (((symbol-function 'taskwarrior-list--selected-uuids)
               (lambda () '("abc")))
              ((symbol-function 'taskwarrior-list--run-action)
               (lambda (&rest arguments) (setq received arguments))))
      (taskwarrior-list-toggle-next)
      (should (equal received '("modify" ("-next") t)))
      (puthash "tags" nil
               (gethash "abc" taskwarrior-list--tasks-by-uuid))
      (taskwarrior-list-toggle-next)
      (should (equal received '("modify" ("+next") t))))))

(ert-deftest taskwarrior-list-entry-formats-and-highlights-exported-task ()
  (with-temp-buffer
    (taskwarrior-list-mode)
    (let* ((task (json-parse-string
                  (concat "{\"uuid\":\"abc\",\"id\":7,\"urgency\":3.25,"
                          "\"project\":\"work\",\"due\":\"20260330T120000Z\","
                          "\"tags\":[\"next\",\"review\"],"
                          "\"description\":\"Test task\"}")
                  :object-type 'hash-table :array-type 'list))
           (entry (taskwarrior-list--entry task))
           (columns (cadr entry)))
      (should (equal (car entry) "abc"))
      (should (equal (mapcar #'substring-no-properties (append columns nil))
                     '("" "7" "3.2" "work" "2026-03-30"
                       "next,review" "Test task")))
      (should (eq (get-text-property 0 'face (aref columns 6))
                  'taskwarrior-list-highlight-face)))))

(ert-deftest taskwarrior-list-highlight-tags-accept-leading-plus ()
  (let ((taskwarrior-list-highlight-tags '("+review"))
        (task (json-parse-string
               "{\"uuid\":\"abc\",\"tags\":[\"review\"]}"
               :object-type 'hash-table :array-type 'list)))
    (should (taskwarrior-list--highlighted-p task))))

(provide 'taskwarrior-test)
;;; taskwarrior-test.el ends here
